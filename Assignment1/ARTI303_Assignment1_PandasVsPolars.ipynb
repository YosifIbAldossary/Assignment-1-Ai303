      "ratio:      4.72x\n"
     ]
    }
   ],
   "source": [
    "pandas_time = measure(\n",
    "    lambda: df_pandas.assign(\n",
    "        new_col=pd.to_numeric(df_pandas[NUMERIC_COL], errors='coerce') - \n",
    "                pd.to_numeric(df_pandas[NUMERIC_COL2], errors='coerce')\n",
    "    )\n",
    ")\n",
    "\n",
    "polars_time = measure(\n",
    "    lambda: df_polars.with_columns(\n",
    "        (pl.col(NUMERIC_COL).cast(pl.Float64, strict=False) - \n",
    "         pl.col(NUMERIC_COL2).cast(pl.Float64, strict=False)).alias(\"new_col\")\n",
    "    )\n",
    ")\n",
    "\n",
    "print(f\"pandas: {pandas_time:8.2f} ms\")\n",
    "print(f\"polars: {polars_time:8.2f} ms\")\n",
    "print(f\"ratio:  {pandas_time/polars_time:8.2f}x\")\n",
    "\n",
    "newcol_pandas, newcol_polars = pandas_time, polars_time"
   ]
  },
