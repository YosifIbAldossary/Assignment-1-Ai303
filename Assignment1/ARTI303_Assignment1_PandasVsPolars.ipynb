     "name": "stdout",
     "output_type": "stream",
     "text": [
      "lazy WITHOUT .collect():    0.027 ms   <- nothing was executed\n",
      "lazy WITH .collect():      29.432 ms   <- the real cost\n"
     ]
    }
   ],
   "source": [
    "lazy_no_collect = measure(lambda: pl.scan_csv(DATA_PATH, infer_schema_length=None, null_values=[\"|\"]).filter(pl.col(df_pandas.columns[0]).is_not_null()))\n",
    "lazy_collected  = measure(lambda: pl.scan_csv(DATA_PATH, infer_schema_length=None, null_values=[\"|\"]).filter(pl.col(df_pandas.columns[0]).is_not_null()).collect())\n",
    "\n",
    "print(f\"lazy WITHOUT .collect(): {lazy_no_collect:8.3f} ms   <- nothing was executed\")\n",
    "print(f\"lazy WITH .collect():    {lazy_collected:8.3f} ms   <- the real cost\")"
   ]
